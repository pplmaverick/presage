# ============================================================
# presage frontend — environment template
#
# VITE_-prefixed  = baked into the client bundle at build time (public, never secrets)
# no VITE_ prefix = visible only inside Vercel Functions (/api/*), never bundled
#
# ⚠ VITE_CONTRACT_MAINNET and VITE_DEPLOY_BLOCK_MAINNET have no defaults.
#   If either is missing the frontend renders a full-page configuration error
#   rather than silently pointing at the wrong contract.
#   Production and Preview are separate environments; set both.
# ============================================================

# ── network selection ─────────────────────────────────────────
# mainnet (default) | testnet
# Unset means mainnet: if someone ships to production and forgets this, the result
# should be "runs on mainnet", not "silently runs on testnet".
VITE_NETWORK=mainnet

# ── client (VITE_ prefix, bundled) ────────────────────────────
# WeatherMarket address on Arc mainnet (from deployments/arc-mainnet.json)
VITE_CONTRACT_MAINNET=0x0000000000000000000000000000000000000000

# WeatherMarket deployment block — where MyBets starts its eth_getLogs scan
VITE_DEPLOY_BLOCK_MAINNET=0

# AdminOracle address (optional). Only /admin's submit-result action needs it;
# when absent that section is disabled and the rest of the site is unaffected.
VITE_ADMIN_ORACLE_MAINNET=

# ── read instead when VITE_NETWORK=testnet (Arc Testnet, chainId 5042002) ──
# VITE_CONTRACT_TESTNET=0x0bfb97a06521f4be7407891530ab22468d3e698c
# VITE_ADMIN_ORACLE_TESTNET=0xf7280ca7e04a8bbdc65edcac80ec49e98c305b2f
# VITE_DEPLOY_BLOCK_TESTNET=62392295

# ── server only (never bundled) ───────────────────────────────
# Upstream RPC for the /api/rpc proxy. Falls back to the public node when unset
# (rate limited). Arc mainnet public node: https://rpc.mainnet.arc.io
ALCHEMY_RPC_URL=

# OpenWeather key used by /api/weather/[city]
OPENWEATHER_API_KEY=
