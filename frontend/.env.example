# ============================================================
# presage 前端 — 環境變數範本
#
# VITE_ 開頭 = build 期打進 client bundle（公開可見，不可放密鑰）
# 無 VITE_ 前綴 = 只在 Vercel Function 內可見（/api/*），不進 bundle
#
# ⚠ VITE_CONTRACT_MAINNET / VITE_DEPLOY_BLOCK_MAINNET 沒有預設值。
#   缺任何一個，前端會整頁顯示「部署設定錯誤」而不是靜默用錯位址。
#   Production 與 Preview 是兩組獨立設定，兩邊都要設。
# ============================================================

# ── 選網路 ────────────────────────────────────────────────────
# mainnet（預設）| testnet
# 未設定時走 mainnet：部署到正式環境卻忘了設，結果應該是「跑主網」
# 而不是「靜默跑測試網」。
VITE_NETWORK=mainnet

# ── client（VITE_ 前綴，會進 bundle）──────────────────────────
# Arc 主網 WeatherMarket 合約位址（部署後填入 deployments/arc-mainnet.json 的值）
VITE_CONTRACT_MAINNET=0x0000000000000000000000000000000000000000

# WeatherMarket 的部署區塊高度，MyBets 的 eth_getLogs 掃描起點
VITE_DEPLOY_BLOCK_MAINNET=0

# AdminOracle 位址（選填）。只有 /admin 的「提交結果」用得到，
# 缺少時該功能停用並顯示提示，不影響一般使用者。
VITE_ADMIN_ORACLE_MAINNET=

# ── VITE_NETWORK=testnet 時改讀這一組（Arc Testnet, chainId 5042002）──
# VITE_CONTRACT_TESTNET=0x0bfb97a06521f4be7407891530ab22468d3e698c
# VITE_ADMIN_ORACLE_TESTNET=0xf7280ca7e04a8bbdc65edcac80ec49e98c305b2f
# VITE_DEPLOY_BLOCK_TESTNET=62392295

# ── server only（不進 bundle）─────────────────────────────────
# /api/rpc 代理的上游 RPC。不設會 fallback 到公開節點（有速率限制）。
# Arc 主網官方公開節點：https://rpc.mainnet.arc.io
ALCHEMY_RPC_URL=

# /api/weather/[city] 用的 OpenWeather key
OPENWEATHER_API_KEY=
