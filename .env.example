# ============================================================
# presage — root environment template
# Used by: Hardhat deployment scripts and the settlement scripts
#
# Usage:
#   cp .env.example .env
#   fill in the real values and save
#
# ⚠  .env is gitignored. Never commit it.
# ============================================================


# ------------------------------------------------------------
# PRIVATE_KEY
# Key of the wallet that deploys contracts and runs every script
# (lockMarket, submitResult, ...).
#
# Format: 64 hex characters, no 0x prefix
# Where to get it: MetaMask -> account details -> export private key
#
# ⚠  Use a dedicated test wallet. Never use a wallet holding real funds.
# ⚠  Anyone with this key controls the wallet completely. Keep it secret.
# ------------------------------------------------------------
PRIVATE_KEY=your_64_char_hex_private_key_without_0x_prefix


# ------------------------------------------------------------
# ARC_RPC_URL
# Arc Testnet RPC endpoint, used by hardhat.config.ts and everything under scripts/
#
# Defaults to the official public node https://rpc.testnet.arc.io when unset.
# The public node tops out at roughly 20 concurrent requests and returns
# -32005 rate limit exceeded beyond that; heavy use warrants a dedicated node
# (replace the line below with your own endpoint).
#
# Note: do not put an example URL containing an API key here — the repo's
# git-secrets pre-commit hook will flag it as a leaked credential and block the commit.
# ------------------------------------------------------------
ARC_RPC_URL=https://rpc.testnet.arc.io


# ------------------------------------------------------------
# ARC_MAINNET_RPC_URL
# Arc Mainnet (chainId 5042) RPC endpoint
#
# Defaults to the official public node https://rpc.mainnet.arc.io when unset.
# ------------------------------------------------------------
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io


# ------------------------------------------------------------
# NETWORK (optional, used by the settlement scripts)
# Target network for scripts/lock-markets.ts and scripts/submit-results.ts
#
# Unset = arc-testnet (the default, so a slip cannot hit mainnet)
# Mainnet operations must opt in explicitly: NETWORK=arc-mainnet
#
# Before sending any transaction the scripts compare the chainId reported by the
# RPC and abort on a mismatch.
# ------------------------------------------------------------
NETWORK=arc-testnet


# ------------------------------------------------------------
# RESULTS (optional, used by submit-results.ts)
# Temperatures to submit this round, as marketId:wholeDegreesCelsius, comma separated
#
# Example: RESULTS="31:33,32:27"
# When unset, the RESULTS constant inside scripts/submit-results.ts is used.
# The city is always read back on-chain and is never specified here.
# ------------------------------------------------------------
# RESULTS=


# ------------------------------------------------------------
# MARKET_IDS (optional, overrides the automatic scan)
# By default both scripts scan 0..nextMarketId-1 for markets that need handling.
# Set this only to restrict them, e.g. MARKET_IDS=31,32
# ------------------------------------------------------------
# MARKET_IDS=


# ------------------------------------------------------------
# USDC_ADDRESS
# USDC address on Arc Testnet
#
# Fixed for Arc Testnet; normally there is no reason to change it.
# Reference: https://docs.arc.io/arc/references/contract-addresses
# ------------------------------------------------------------
USDC_ADDRESS=0x3600000000000000000000000000000000000000


# ------------------------------------------------------------
# PHAROS_USDC_ADDRESS
# USDC address on Pharos Testnet
#
# Used by the pharos scripts (deploy-pharos.ts, e2e-pharos.ts, ...).
# Different from Arc Testnet's USDC; the two chains are independent.
# ------------------------------------------------------------
PHAROS_USDC_ADDRESS=0xYourPharosUsdcContractAddressHere
