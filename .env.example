# ============================================================
# presage — 根目錄環境變數範本
# 用途：Hardhat 部署腳本 / Oracle 結算腳本
#
# 使用方式：
#   cp .env.example .env
#   填入真實數值後儲存
#
# ⚠️  .env 已加入 .gitignore，禁止提交到 git
# ============================================================


# ------------------------------------------------------------
# 🔑 PRIVATE_KEY
# 部署合約與執行所有腳本（lockMarket、submitResult 等）的錢包私鑰
#
# 格式：64 位十六進位字串，不含 0x 前綴
# 取得方式：MetaMask → 帳戶詳細資料 → 匯出私鑰
#
# ⚠️  請使用「測試專用錢包」，切勿使用存放大量資產的主錢包
# ⚠️  私鑰洩漏即代表錢包資產可被完全控制，務必保密
# ------------------------------------------------------------
PRIVATE_KEY=your_64_char_hex_private_key_without_0x_prefix


# ------------------------------------------------------------
# 🌐 ARC_RPC_URL
# Arc Testnet 的 RPC endpoint，供 hardhat.config.ts 與 scripts/ 底下所有腳本使用
#
# 不設定的話會 fallback 到官方公開節點 https://rpc.testnet.arc.io
# 公開節點的並發上限實測約 20，短時間內大量請求會回 -32005 rate limit exceeded；
# 高頻使用建議換成專屬節點（把下面這行整個換成你的端點 URL）。
#
# 注意：這裡不要放帶 API key 的範例 URL，repo 的 git-secrets pre-commit hook
# 會把它判定成外洩的金鑰而擋下 commit。
# ------------------------------------------------------------
ARC_RPC_URL=https://rpc.testnet.arc.io


# ------------------------------------------------------------
# 🌐 ARC_MAINNET_RPC_URL
# Arc 主網（chainId 5042）的 RPC endpoint
#
# 不設定會 fallback 到官方公開節點 https://rpc.mainnet.arc.io
# ------------------------------------------------------------
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io


# ------------------------------------------------------------
# 🔀 NETWORK（結算腳本用，可選）
# scripts/lock-markets.ts 與 scripts/submit-results.ts 的目標網路
#
# 不設定 = arc-testnet（預設，避免手滑打到主網）
# 主網操作必須顯式指定：NETWORK=arc-mainnet
#
# 腳本送任何交易前會先比對 RPC 回的 chainId，不符直接中止。
# ------------------------------------------------------------
NETWORK=arc-testnet


# ------------------------------------------------------------
# 🌡 RESULTS（submit-results.ts 用，可選）
# 本輪要提交的溫度，格式 marketId:整數攝氏，逗號分隔
#
# 範例：RESULTS="31:33,32:27"
# 不設定的話讀 scripts/submit-results.ts 裡的 RESULTS 常數。
# city 一律從鏈上讀回，不由這裡指定。
# ------------------------------------------------------------
# RESULTS=


# ------------------------------------------------------------
# 🎯 MARKET_IDS（可選，覆寫自動掃描）
# 兩支腳本預設會掃 0..nextMarketId-1 找出該處理的市場。
# 只想處理特定幾個時才設，格式：MARKET_IDS=31,32
# ------------------------------------------------------------
# MARKET_IDS=


# ------------------------------------------------------------
# 📍 USDC_ADDRESS
# Arc Testnet 上的 USDC Precompile 合約地址
#
# Arc Testnet 固定值，一般不需要修改
# 參考：https://docs.arc.network/testnet/precompiles
# ------------------------------------------------------------
USDC_ADDRESS=0x3600000000000000000000000000000000000000


# ------------------------------------------------------------
# 📍 PHAROS_USDC_ADDRESS
# Pharos Testnet 上的 USDC 合約地址
#
# 用途：pharos 相關腳本（deploy-pharos.ts、e2e-pharos.ts 等）
# 與 Arc Testnet 的 USDC 地址不同，兩條鏈各自獨立
# 取得方式：Pharos 官方文件或部署後的合約地址
# ------------------------------------------------------------
PHAROS_USDC_ADDRESS=0xYourPharosUsdcContractAddressHere
